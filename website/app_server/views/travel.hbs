<div id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>Travel</h1>

        <ul id="sites">
          {{#each trips}}
            <li>
              <a href="/api/trips/{{code}}">
                <img src="/{{image}}" alt="{{name}}">
              </a>

              <h2>
                <a href="/api/trips/{{code}}">
                  {{name}}
                </a>
              </h2>

              <p>{{description}}</p>
              <p>{{details}}</p>
            </li>
          {{/each}}
        </ul>

      </div>
    </div>
  </div>
</div>
